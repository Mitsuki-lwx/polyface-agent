# ===== LLM Provider (OpenAI 兼容) =====
# 示例为商汤 SenseNova；换 DeepSeek/通义/OpenAI 仅需改 base_url + model
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=
LLM_MODEL=sensenova-6.8-flash-lite
LLM_QA_MODEL=sensenova-6.8-flash-lite

# 填入 API Key 后改为 false 走真实模型；留 true 则用本地 mock（离线演示/测试）
LLM_MOCK=true

# ===== 服务 =====
LLM_HOST=127.0.0.1
LLM_PORT=8000

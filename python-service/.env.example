# ============================================================
# Polyface LLM 服务配置
#
# 复制本文件为 .env 后修改。**不改也能启动**（走离线演示模式）。
#
# ⚠️ 变量名说明：本文件里的变量名由 app/config.py 的 Settings 字段名
#    直接大写而来（如 llm_mock -> LLM_MOCK），**没有 POLYFACE_ 前缀**。
#    另有少数几个运行时变量（POLYFACE_DATA_DIR / POLYFACE_DNA_DIR /
#    POLYFACE_FFMPEG / POLYFACE_ASR_MODEL / POLYFACE_USAGE_FILE）由代码
#    用 os.environ 显式读取，带前缀，一般不用写在 .env 里。
#
# ⚠️ 数据边界：填了 Key 并设为 LLM_MOCK=false 后，**素材正文会发送给
#    你所配置的 LLM 服务商**。详见 README「数据边界」与 docs/08 ADR-017。
# ============================================================

# ===== LLM Provider（任意 OpenAI 兼容接口）=====
# 示例为商汤 SenseNova；换 DeepSeek / 通义 / OpenAI 只需改 base_url + model
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=
LLM_MODEL=sensenova-6.8-flash-lite
LLM_QA_MODEL=sensenova-6.8-flash-lite

# true  = 离线演示模式（默认）。不联网、秒级返回，但产出是**演示结果**
# false = 走真实模型，**必须**同时填 LLM_API_KEY，否则会退化为 mock 并在日志里告警
LLM_MOCK=true

# ===== 服务 =====
LLM_HOST=127.0.0.1
LLM_PORT=8000

# ===== 音视频入料（FR-51，可选）=====
# 留空 = 用 PATH 里的 ffmpeg。视频入料需要 ffmpeg（https://ffmpeg.org/download.html）
FFMPEG_PATH=
# 本地 ASR 模型尺寸（需另行安装 faster-whisper；不装则字幕缺失时降级为「需手工粘贴」）
ASR_MODEL=small

# ===== 封面成图（M6-1，可选）=====
# 后台图像编辑器 gimpish（https://github.com/jvanderberg/gimpish，MIT）。
# 需要 Node.js ≥ 20.19：npm install -g gimpish
# 留空 = 用 PATH 里的 gimpish；也可用环境变量 POLYFACE_GIMPISH 指向可执行文件/入口 js。
# 未安装时「生成封面」降级为 needs_manual + 安装指引，不影响其余功能。
GIMPISH_PATH=

# ===== LLM 运行时加固（FR-70）=====
# 单次 LLM 请求超时（秒）。
# ⚠️ 别和 Java 侧的「任务预算」混淆 —— 那是两个不同的东西：
#    · 这里 LLM_TIMEOUT_SEC（Python，默认 60）    = 一次模型调用的上限
#    · POLYFACE_LLM_TIMEOUT_SEC（Java，默认 240） = 整个生成任务的上限
#    前者是后者的组成部分。调大任务预算而不动这里，仍会在单次调用处超时。
#
# ⚠️ **推理模型要把这个值放大**（实测 2026-10-08，cline-pass/deepseek-v4.1-flash）：
#    成功调用中位 33.8s，但尾巴很长（61s / 62s / 64s / 105s 都有）；
#    而**失败的 29 次全部卡在 60.6s** —— 也就是说 60 秒这个值本身在制造失败：
#    超时 → 重试 → 又一次超时，整轮跑分被拖慢一倍以上。
#    换成推理模型时先看用量日志里成功调用的耗时分布，再定这个值。
LLM_TIMEOUT_SEC=60
# 单模型最大尝试次数（含首次）
LLM_MAX_ATTEMPTS=3
# 模型返回的 JSON **解析失败**时的重试次数（含首次）。
# 为什么需要：模型偶发返回坏 JSON 是常态（实测 4 次草稿调用里中 2 次），
# 而上面的 LLM_MAX_ATTEMPTS 只管网络/限流 —— 解析发生在调用返回之后，
# 不在这里重试的话，一次坏 JSON 就让整个平台生成失败。
# 取 2 而不是沿用 3：避免与模型降级链的重试相乘。
LLM_JSON_RETRIES=2
# 主模型不可用时的降级链（逗号分隔；显式传 model= 时不走链）
LLM_FALLBACK_MODELS=deepseek-v4-pro,glm-5.2,sensenova-6.8-flash-lite
# 两次调用之间的最小间隔（毫秒）。上游 tpm/rpm 紧，间隔太小会连续 429
LLM_MIN_INTERVAL_MS=1500
# 多平台是否并行。默认 false（串行）—— 实测并发会被大面积限流
LLM_PARALLEL=false

# ===== 可观测（FR-71/72，可选）=====
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== CORS =====
# 留空 = 不启用跨域（**推荐**）。浏览器只与 Java 工作台(:8080)同源通信，
# Java 调本服务是服务端请求，不受 CORS 约束，因此本服务不需要跨域。
#
# 不要填 * ：本服务无鉴权，放行任意来源会让**任何网页**都能调用
# 127.0.0.1:8000 消耗你的模型额度并读走稿件内容。
# 仅在需要前端直连调试时，显式列出允许的来源（逗号分隔）：
CORS_ORIGINS=
